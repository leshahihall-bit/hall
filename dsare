-- Настройки функций
local toggles = {
    MurdererESP = true,
    SheriffESP = true,
    InnocentESP = true,
    Aimbot = false,
    KnifeAura = false
}

local colors = {
    MurdererESP = Color3.fromRGB(255, 0, 0),
    SheriffESP = Color3.fromRGB(0, 120, 255),
    InnocentESP = Color3.fromRGB(0, 255, 0),
    Aimbot = Color3.fromRGB(255, 165, 0),
    KnifeAura = Color3.fromRGB(180, 0, 255)
}

local function createButton(posY, key, labelText)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = toggles[key] and colors[key] or Color3.fromRGB(80, 80, 80)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = labelText .. ": " .. (toggles[key] and "ON" or "OFF")
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize, btn.Parent = 13, Frame

    btn.MouseButton1Click:Connect(function()
        toggles[key] = not toggles[key]
        btn.Text = labelText .. ": " .. (toggles[key] and "ON" or "OFF")
        btn.BackgroundColor3 = toggles[key] and colors[key] or Color3.fromRGB(80, 80, 80)
    end)
end

