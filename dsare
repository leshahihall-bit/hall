-- Определение ролей в MM2
local function getRole(player)
    if not player.Character then return "Innocent" end
    local backpack = player:FindFirstChild("Backpack")
    local char = player.Character
    
    local function hasTool(name)
        return char:FindFirstChild(name) or (backpack and backpack:FindFirstChild(name))
    end
    
    if hasTool("Knife") then
        return "Murderer"
    elseif hasTool("Gun") then
        return "Sheriff"
    end
    return "Innocent"
end

-- Поиск цели для шерифа
local function getSheriffTarget()
    local nearestPlayer, shortestDistance = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if getRole(player) == "Murderer" then
                return player
            end
            local dist = (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance, nearestPlayer = dist, player
            end
        end
    end
    return nearestPlayer
end

-- Основной цикл для Aimbot и Knife Helper
RunService.RenderStepped:Connect(function()
    if not LocalPlayer.Character then return end
    local currentTool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
    
    -- Логика шерифа (Аймбот)
    if toggles.Aimbot and getRole(LocalPlayer) == "Sheriff" and currentTool and currentTool.Name == "Gun" then
        local target = getSheriffTarget()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
        end
    end
    
    -- Логика убийцы (Увеличение хитбоксов)
    if toggles.KnifeAura and getRole(LocalPlayer) == "Murderer" and currentTool and currentTool.Name == "Knife" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                hrp.Size = Vector3.new(12, 12, 12)
                hrp.Transparency = 0.8
                hrp.CanCollide = false
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                if hrp.Size ~= Vector3.new(2, 2, 1) then
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end
            end
        end
    end
end)

-- Цикл обновления ESP подсветки
task.spawn(function()
    while true do
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local role = getRole(player)
                local espKey = role .. "ESP"
                
                local hl = char:FindFirstChild("MM2_Highlight")
                if toggles[espKey] then
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "MM2_Highlight"
                        hl.Adornee = char
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.Parent = char
                    end
                    hl.FillColor = colors[espKey]
                    hl.OutlineColor = colors[espKey]
                else
                    if hl then
                        hl:Destroy()
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)
